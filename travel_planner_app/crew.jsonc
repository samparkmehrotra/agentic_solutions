{
  // Display name for this crew
  "name": "travel-planner-app",

  // Agents to include
  "agents": ["travel_researcher", "itinerary_planner"],

  // Tasks executed in order
  "tasks": [
    {
      "name": "research_travel_options",

      "description": "Perform travel research for {topic}. REQUIRED PROCEDURE: Step 1 — call the AgentCore travel database lookup tool with the destination city. Do not produce research before this call. Step 2 — inspect the Gateway result. If the result is FOUND, record the returned city, budget, duration, and itinerary as database information. If the result is NOT_FOUND or ERROR, you MUST call the Free web search tool before continuing. Step 3 — use the Free web search tool to research the destination and gather current/relevant information about attractions, recommended duration, transportation, accommodation areas, activities, approximate costs, and travel logistics. Step 4 — compare transportation options including car, bus, train, and flight where applicable. Step 5 — produce the structured research report. A research report for a NOT_FOUND destination is invalid unless it contains information obtained from the Free web search tool. Do not use your own general knowledge as a substitute for either required tool call.",

      "expected_output": "A structured research report for {topic}. The report MUST contain a Gateway database lookup result. If the Gateway result is NOT_FOUND or ERROR, it MUST also contain Free web search results. Include destination information, attractions, activities, recommended duration, accommodation areas, transportation comparison, cheapest practical transport option, estimated fares, travel times, approximate budget, logistics, assumptions, uncertainties, and source references. Do not claim that web research was performed unless information was actually returned by the Free web search tool.",

      "agent": "travel_researcher"
    },

    {
      "name": "create_travel_itinerary",

      "description": "Using the user's original travel requirements for {topic} and the research produced by the travel researcher, create a practical day-by-day travel itinerary. Use the research report as the primary source of travel information. Align the itinerary with the user's dates, travelers, budget, interests, pace, transportation priority, accommodation requirements, and other constraints. Consider geographical proximity, realistic travel times, meal breaks, rest periods, and unnecessary backtracking. Do not invent facts, prices, availability, bookings, dates, or user preferences that are not supported by the user's requirements or the research report. Clearly identify assumptions, estimates, uncertainties, and information requiring confirmation.",

      "expected_output": "A complete day-by-day travel itinerary based on the travel research report. Include dates or days, locations, activities, recommended sequence, estimated timing, transportation between major activities, approximate costs where available, meal or break suggestions, practical notes, assumptions, estimates, uncertainties, and information requiring verification.",

      "markdown": true,

      "agent": "itinerary_planner"
    }
  ],

  // Execution process
  "process": "sequential",

  // Enable verbose logging
  "verbose": true,

  // Crew memory
  "memory": false,

  // Enable task caching
  "cache": true,

  // Runtime inputs
  "inputs": {}
}