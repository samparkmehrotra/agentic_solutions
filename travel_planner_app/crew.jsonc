{
  // Display name for this crew
  "name": "travel-planner-app",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["travel_researcher", "itinerary_planner"],

  // Task definitions — executed in order for sequential process
  "tasks": [
    {
      "name": "research_travel_options",
      "description": "Research the user's travel requirements for {topic}, travel dates, number of travelers, budget, interests, preferred pace, transportation preferences, accommodation preferences, and any other constraints. Gather and validate current information about suitable destinations, attractions, activities, transportation options, accommodation areas, estimated costs, travel times, local logistics, and important considerations. Use reliable sources and identify any information that is uncertain, conflicting, or requires further verification.",
      "expected_output": "A structured and comprehensive research report containing validated travel options, relevant attractions and activities, transportation options, accommodation recommendations or areas, estimated costs, travel times, important logistics, assumptions, uncertainties, and source references. The information must be organized so that the itinerary planner can directly use it to construct the final itinerary.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "travel_researcher"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "create_travel_itinerary",
      "description": "Using the user's original travel requirements to {topic} and the research produced by the travel researcher, create a practical and optimized day-by-day travel itinerary. Select activities, attractions, transportation, and locations that best match the user's budget, interests, dates, travel pace, and constraints. Consider geographical proximity, realistic travel times, opening hours where available, meal breaks, rest periods, and unnecessary backtracking. Clearly identify important assumptions and any items that require user confirmation.",
      "expected_output": "A complete day-by-day itinerary containing dates or days, locations, activities, recommended sequence, estimated timing, transportation between major activities, approximate costs where available, meal or break suggestions, and important practical notes. The itinerary should be realistic, logically sequenced, aligned with the user's requirements, and clearly identify any assumptions or information that needs verification.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
       "markdown": true,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "itinerary_planner"
                                                                                                                                                                                                                                                                                                              
      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }

  ],

  // Execution process
  // "sequential" — tasks run in order, each receiving prior task outputs
  // "hierarchical" — a manager agent delegates tasks (requires manager_llm)
  "process": "sequential",

  // Enable verbose logging during execution
  "verbose": true,

  // Enable crew memory — persists context and learnings across tasks
  "memory": true,

  // Automatically plan the execution strategy before running tasks
  // "planning": false,

  // LLM for the planning step (used when planning is true)
  // "planning_llm": "openai/gpt-4o",

  // LLM for the manager agent (required when process is "hierarchical")
  // "manager_llm": "openai/gpt-4o",

  // Crew-level LLM fields also accept object form for custom endpoints
  // "chat_llm": {"model": "llama3", "provider": "ollama", "base_url": "http://localhost:11434"},

  // Advanced crew options:
  // Docs: https://docs.crewai.com/concepts/crews
  // For hierarchical crews, manager_agent can reference an agents/<name>.jsonc file
  // that is not included in the "agents" list.
  // "manager_agent": "research_analyst",
  // "before_kickoff_callbacks": [{"python": "my_project.callbacks.before_kickoff"}],
  // "after_kickoff_callbacks": [{"python": "my_project.callbacks.after_kickoff"}],
  // "function_calling_llm": "openai/gpt-4o-mini",
  // "max_rpm": null,
  // "cache": true,
  // "knowledge_sources": [],
  // "embedder": {},
  // "output_log_file": "crew.log",
  // "stream": false,
  // "tracing": false,
  // "security_config": {},

  // Optional runtime input defaults.
  // Use {placeholder} in agent or task text, for example:
  // "description": "Research {topic} and write a brief"
  // `crewai run` prompts for any placeholders missing from this object.
  "inputs": {}
}
